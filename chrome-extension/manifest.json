{
  "manifest_version": 3,
  "name": "ChatGPT Image Archive",
  "version": "1.0.2",
  "description": "Automatically archive generated ChatGPT images to your Telegram bot's Supabase archive.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.oaiusercontent.com/*",
    "https://*.openai.com/*",
    "https://bot-bharatgptimagebot.fadehost.app/*"
  ],
  "optional_host_permissions": [],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {"default_popup": "popup.html", "default_title": "ChatGPT Image Archive"}
}